# Server
PORT=3100
NODE_ENV=development

# CORS — comma-separated origins allowed to call this API
APP_ORIGIN=http://localhost:5173,http://localhost:5174,http://192.168.178.77:5174

# MySQL (configure to match your local MySQL setup)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=k342943_foodconnect
DB_USER=root
DB_PASSWORD=

# SMTP (nodemailer)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@example.com
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM="FoodConnectMarkt <newsletter@foodconnectmarkt.de>"

# Admin panel password (required to access /admin)
ADMIN_PASSWORD=change-me

# Public URL of THIS server (used in confirmation email links)
SERVER_URL=http://localhost:3100

# Public URL of the frontend (used in email redirect after confirmation)
FRONTEND_URL=http://localhost:5174
